@Zoryn.Api_HostAddress = http://localhost:5202

POST {{Zoryn.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "analyst@zoryn.test",
  "password": "ChangeMe!123",
  "displayName": "Test Analyst"
}

###

# @name login
POST {{Zoryn.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "analyst@zoryn.test",
  "password": "ChangeMe!123"
}

###

GET {{Zoryn.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Monitoring regions: reads are public, writes need a token. The body is
# the region name as a JSON string.

GET {{Zoryn.Api_HostAddress}}/api/MonitoringRegions
Accept: application/json

###

# @name createRegion
POST {{Zoryn.Api_HostAddress}}/api/MonitoringRegions
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

"Kibera"

###

PUT {{Zoryn.Api_HostAddress}}/api/MonitoringRegions/{{createRegion.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

"Kibera North"

###

DELETE {{Zoryn.Api_HostAddress}}/api/MonitoringRegions/{{createRegion.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###
