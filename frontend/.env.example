# Frontend settings (Vite). Copy to .env.local; all are optional.

# Python reasoning API.
VITE_API_BASE_URL=http://127.0.0.1:8000

# .NET account API (sign-up, sign-in).
VITE_AUTH_API_BASE_URL=http://localhost:5202

# MapTiler basemap. Without a key the map uses OpenFreeMap's Positron style.
VITE_MAPTILER_API_KEY=
