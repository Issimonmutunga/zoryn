# Python reasoning API (uvicorn zoryn.rest.app:app). Copy to .env.

# "stub" returns a placeholder explanation; "groq" calls Groq.
ZORYN_EXPLANATION_PROVIDER=stub

# Required when ZORYN_EXPLANATION_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=800
GROQ_TIMEOUT=60

# Extra CORS origin for a deployed frontend (localhost:5173 is always allowed).
FRONTEND_URL=
